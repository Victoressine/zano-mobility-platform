# ========================================
# Zano - Git Ignore
# ========================================

# Dependencies
**/node_modules/

# Next.js
**/.next/
**/out/
**/build/

# Firebase
**/.firebase/
**/firebase-debug.log
**/firestore-debug.log
**/ui-debug.log
**/*-debug.log

# Environment files / secrets
**/.env
**/.env.*
!**/.env.example

# Credentials / private keys
**/*.pem
**/*service-account*.json
**/*serviceAccount*.json
**/serviceAccountKey.json

# TypeScript
**/*.tsbuildinfo

# Coverage
**/coverage/

# Package managers
**/.pnp
**/.pnp.*
**/.yarn/*
!**/.yarn/patches
!**/.yarn/plugins
!**/.yarn/releases
!**/.yarn/versions

# OS
.DS_Store
**/.DS_Store

# Logs
**/*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Vercel
**/.vercel/
