rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ========================================
    // Authentication Helpers
    // ========================================

    function isSignedIn() {
      return request.auth != null;
    }

   function isOwner(userId) {

  return isSignedIn() &&
         request.auth.uid == userId;

}

// ========================================
// Operator Authorization
// ========================================

// Operator membership documents use the
// authenticated Firebase UID as document ID:
//
// operatorMembers/{uid}
//
// Example:
// {
//   userId: "<uid>",
//   companyId: "vip-jeoun",
//   role: "admin",
//   status: "active"
// }

function operatorMemberPath() {

  return /databases/$(database)/documents/operatorMembers/$(request.auth.uid);

}

function isActiveOperator() {

  return isSignedIn() &&
         exists(operatorMemberPath()) &&
         get(operatorMemberPath()).data.userId ==
           request.auth.uid &&
         get(operatorMemberPath()).data.status ==
           "active";

}

function operatorCompanyId() {

  return get(operatorMemberPath()).data.companyId;

}

function belongsToOperatorCompany(companyId) {

  return isActiveOperator() &&
         operatorCompanyId() == companyId;

}

// ========================================

// User Profile Validation

// ========================================

    function isPassengerProfile() {
      return request.resource.data.role == "passenger";
    }

    function isValidNewPassengerProfile() {
      return isPassengerProfile() &&
             request.resource.data.keys().hasAll([
               "firstName",
               "lastName",
               "phoneNumber",
               "email",
               "role",
               "authProvider",
               "createdAt",
               "updatedAt"
             ]);
    }

    function roleHasNotChanged() {
      return request.resource.data.role ==
             resource.data.role;
    }

    // ========================================
    // User Profiles
    // ========================================

    match /users/{userId} {

      // User can retrieve only their own profile.
      allow get: if isOwner(userId);

      // Do not allow collection-wide user listing.
      allow list: if false;

      // Public registration may only create
      // a passenger profile for the authenticated user.
      allow create: if isOwner(userId) &&
                    isValidNewPassengerProfile();

      // User may update their own profile,
      // but cannot change their role.
      allow update: if isOwner(userId) &&
                    roleHasNotChanged();

      // User profiles are not deleted directly
      // from the browser.
      allow delete: if false;
    }

// ========================================
// Operator Memberships
// ========================================
//
// Membership records are provisioned only
// through trusted Zano administration.
//
// An authenticated operator may retrieve
// their own membership record.
//
// Operators cannot create, modify or delete
// memberships from the browser.
// ========================================

match /operatorMembers/{userId} {

  allow get: if isOwner(userId);

  allow list: if false;

  allow create, update, delete: if false;

}
    // ========================================
    // Passenger Bookings
    // ========================================

    match /bookings/{bookingId} {

      // Individual booking access.
      allow get: if isSignedIn() &&
                 resource.data.userId ==
                 request.auth.uid;

      // Required for dashboard queries such as:
      //
      // where("userId", "==", user.uid)
      //
      // Firestore will only allow the query when
      // it can prove every returned booking belongs
      // to the authenticated passenger.
      allow list: if isSignedIn() &&
                  resource.data.userId ==
                  request.auth.uid;

      // Booking writes must be handled later
      // through trusted backend logic.
      allow create, update, delete: if false;
    }

    // ========================================
    // Passenger Tickets
    // ========================================

    match /tickets/{ticketId} {

      // Passenger may retrieve only their ticket.
      allow get: if isSignedIn() &&
                 resource.data.userId ==
                 request.auth.uid;

      // Supports passenger dashboard ticket query.
      allow list: if isSignedIn() &&
                  resource.data.userId ==
                  request.auth.uid;

      // Tickets must be issued/modified
      // through trusted backend logic.
      allow create, update, delete: if false;
    }

     // ========================================
    // Public Trip Discovery
    // ========================================
    //
    // Trip information is public so passengers
    // can search and inspect trips before login.
    //
    // All writes remain server/operator controlled.
    // ========================================

match /trips/{tripId} {

  // ========================================
  // Public Trip Reading
  // ========================================

  // Passengers and guests can browse trips.
  allow get, list: if true;

  // ========================================
  // Operator Trip Creation
  // ========================================
  //
  // A trip may be created only when:
  //
  // 1. The operator belongs to the company.
  // 2. vehicleId is provided.
  // 3. The selected vehicle exists.
  // 4. The vehicle belongs to the same company.
  // 5. The vehicle is active.
  // ========================================

  allow create: if

  // ========================================
  // Company Authorization
  // ========================================

  belongsToOperatorCompany(
    request.resource.data.companyId
  ) &&

  // ========================================
  // Required Trip Fields
  // ========================================

  request.resource.data.companyId is string &&
  request.resource.data.vehicleId is string &&
  request.resource.data.routeId is string &&

  request.resource.data.origin is string &&
  request.resource.data.destination is string &&

  request.resource.data.departureTime is string &&
  request.resource.data.arrivalTime is string &&

  request.resource.data.busType is string &&

  request.resource.data.fare is number &&
  request.resource.data.fare >= 0 &&

  request.resource.data.totalSeats is int &&
  request.resource.data.totalSeats > 0 &&

  request.resource.data.availableSeats is int &&
  request.resource.data.availableSeats >= 0 &&
  request.resource.data.availableSeats <=
    request.resource.data.totalSeats &&

  request.resource.data.bookingEnabled is bool &&
  request.resource.data.status is string &&

  // ========================================
  // Vehicle Validation
  // ========================================

  exists(
    /databases/$(database)/documents/vehicles/$(request.resource.data.vehicleId)
  ) &&

  get(
    /databases/$(database)/documents/vehicles/$(request.resource.data.vehicleId)
  ).data.companyId ==
    request.resource.data.companyId &&

  get(
    /databases/$(database)/documents/vehicles/$(request.resource.data.vehicleId)
  ).data.status ==
    "active" &&

  // ========================================
  // Vehicle Capacity Protection
  // ========================================
  //
  // A 30-seat vehicle cannot publish a trip
  // claiming to have 45 seats.
  // ========================================

    request.resource.data.totalSeats ==
    get(
      /databases/$(database)/documents/vehicles/$(request.resource.data.vehicleId)
    ).data.seatCapacity &&

  // ========================================
  // Route Validation
  // ========================================
  //
  // The selected route must exist and must
  // belong to the same company as the trip.
  // ========================================

  exists(
    /databases/$(database)/documents/routes/$(request.resource.data.routeId)
  ) &&

  get(
    /databases/$(database)/documents/routes/$(request.resource.data.routeId)
  ).data.companyId ==
    request.resource.data.companyId &&

  get(
    /databases/$(database)/documents/routes/$(request.resource.data.routeId)
  ).data.status ==
    "active" &&

  // The trip origin/destination must match
  // the selected route.
  request.resource.data.origin ==
    get(
      /databases/$(database)/documents/routes/$(request.resource.data.routeId)
    ).data.origin &&

  request.resource.data.destination ==
    get(
      /databases/$(database)/documents/routes/$(request.resource.data.routeId)
    ).data.destination;

  // ========================================
  // Operator Trip Updates
  // ========================================
  //
  // Existing trips remain editable by their
  // own company.
  //
  // This deliberately continues supporting
  // historical trips that were created before
  // vehicleId was introduced.
  // ========================================

  allow update: if
    belongsToOperatorCompany(
      resource.data.companyId
    ) &&

    belongsToOperatorCompany(
      request.resource.data.companyId
    ) &&

    request.resource.data.companyId ==
      resource.data.companyId;

  // ========================================
  // Trip Deletion
  // ========================================
  //
  // Trips are not physically deleted because
  // bookings, payments and tickets may reference
  // them. Trips will instead be cancelled or
  // completed.
  // ========================================

  allow delete: if false;
}

   // ========================================
// Routes
// ========================================

match /routes/{routeId} {

  // Passengers and guests can read routes
  // used for trip discovery.
  allow get, list: if true;

  // ========================================
  // Operator Route Creation
  // ========================================
  //
  // Operators may create routes only for
  // their own transport company.
  // ========================================

  allow create: if
    belongsToOperatorCompany(
      request.resource.data.companyId
    ) &&

    request.resource.data.companyId is string &&
    request.resource.data.origin is string &&
    request.resource.data.destination is string &&
    request.resource.data.status is string &&

    request.resource.data.origin.size() > 0 &&
    request.resource.data.destination.size() > 0 &&

    request.resource.data.origin !=
      request.resource.data.destination;

  // ========================================
  // Operator Route Updates
  // ========================================
  //
  // An operator may update only routes
  // belonging to their company.
  //
  // companyId cannot be changed.
  // ========================================

  allow update: if
    belongsToOperatorCompany(
      resource.data.companyId
    ) &&

    belongsToOperatorCompany(
      request.resource.data.companyId
    ) &&

    request.resource.data.companyId ==
      resource.data.companyId &&

    request.resource.data.origin is string &&
    request.resource.data.destination is string &&
    request.resource.data.status is string &&

    request.resource.data.origin.size() > 0 &&
    request.resource.data.destination.size() > 0 &&

    request.resource.data.origin !=
      request.resource.data.destination;

  // Routes may later be referenced by historical
  // trips, bookings and tickets, so physical
  // deletion is blocked. A route can instead
  // be made inactive.
  allow delete: if false;
}

    // ========================================
    // Public Transport Companies
    // ========================================

    match /companies/{companyId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    // ========================================
// Public Vehicle Information
// ========================================

match /vehicles/{vehicleId} {

  // Passengers and guests may view vehicle
  // information used by published trips.
  allow get, list: if true;

  // ========================================
  // Operator Vehicle Creation
  // ========================================
  //
  // The authenticated operator may create a
  // vehicle only for their assigned company.
  // ========================================

  allow create: if
    belongsToOperatorCompany(
      request.resource.data.companyId
    );

  // ========================================
  // Operator Vehicle Updates
  // ========================================
  //
  // The existing vehicle must belong to the
  // operator's company.
  //
  // The new document must still belong to the
  // same company so companyId cannot be changed.
  // ========================================

  allow update: if
    belongsToOperatorCompany(
      resource.data.companyId
    ) &&
    belongsToOperatorCompany(
      request.resource.data.companyId
    ) &&
    request.resource.data.companyId ==
      resource.data.companyId;

  // ========================================
  // Vehicle Deletion
  // ========================================
  //
  // Physical deletion stays blocked because a
  // vehicle may already be referenced by trips,
  // bookings or historical passenger records.
  //
  // Operators will deactivate vehicles instead.
  // ========================================

  allow delete: if false;
}

    // ========================================
    // Public Seat Layout
    // ========================================
    //
    // Passengers may inspect seat layouts before
    // login but cannot reserve or modify seats.
    // ========================================

    match /seats/{seatId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    // ========================================
    // Public Date-Specific Seat Availability
    // ========================================
    //
    // Passengers may inspect availability for a
    // selected journey date before login.
    //
    // Inventory cannot be created, reserved,
    // booked, updated, or deleted by the client.
    // Secure server-side booking handles writes.
    // ========================================

    match /tripSeatInventory/{inventoryId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

// ========================================
// Payments
// ========================================

    match /payments/{paymentId} {

      allow get: if isSignedIn() &&
                 resource.data.userId ==
                 request.auth.uid;

      allow list: if isSignedIn() &&
                  resource.data.userId ==
                  request.auth.uid;

      // Never allow payment creation or
      // modification directly from browser.
      allow create, update, delete: if false;
    }

    // ========================================
    // Passenger Notifications
    // ========================================

    match /notifications/{notificationId} {

      allow get: if isSignedIn() &&
                 resource.data.userId ==
                 request.auth.uid;

      allow list: if isSignedIn() &&
                  resource.data.userId ==
                  request.auth.uid;

      // Notification generation will be handled
      // by trusted backend logic.
      allow create, update, delete: if false;
    }

    // ========================================
    // Reviews
    // ========================================

    match /reviews/{reviewId} {

      // Authenticated passengers can read reviews.
      allow get, list: if isSignedIn();

      // Review writing will be implemented later
      // with completed-trip validation.
      allow create, update, delete: if false;
    }

    // ========================================
    // Deny Everything Else
    // ========================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}